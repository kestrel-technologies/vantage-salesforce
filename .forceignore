# Files the sf CLI must not push or retrieve.
# https://developer.salesforce.com/docs/atlas.en-us.sfdx_dev.meta/sfdx_dev/sfdx_dev_exclude_source.htm

package.xml

# LWC configuration and tests
**/jsconfig.json
**/.eslintrc.json
**/__tests__/**

# Org-generated or org-specific components we do not manage in source
**/profilePasswordPolicies/**
**/profileSessionSettings/**
**/appMenus/**
**/*.dup
