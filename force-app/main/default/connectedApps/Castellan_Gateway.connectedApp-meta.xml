<?xml version="1.0" encoding="UTF-8"?>
<ConnectedApp xmlns="http://soap.sforce.com/2006/04/metadata">
    <contactEmail>assessment@castellan.example</contactEmail>
    <description>Castellan Partners assessment gateway, read-only. ENTSEC-EXC-1142.</description>
    <label>Castellan Gateway</label>
    <oauthConfig>
        <callbackUrl>https://gateway.castellan.example/oauth/callback
http://localhost:1717/OauthRedirect</callbackUrl>
        <isAdminApproved>true</isAdminApproved>
        <isConsumerSecretOptional>true</isConsumerSecretOptional>
        <isIntrospectAllTokens>false</isIntrospectAllTokens>
        <isSecretRequiredForRefreshToken>true</isSecretRequiredForRefreshToken>
        <scopes>Api</scopes>
        <scopes>RefreshToken</scopes>
        <scopes>Web</scopes>
    </oauthConfig>
    <oauthPolicy>
        <ipRelaxation>BYPASS</ipRelaxation>
        <refreshTokenPolicy>infinite</refreshTokenPolicy>
    </oauthPolicy>
    <profileName>Castellan Read-Only</profileName>
</ConnectedApp>
