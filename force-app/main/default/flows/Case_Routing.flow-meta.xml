            </connector>
            <label>New Case</label>
        </rules>
    </decisions>
    <description>Owner: Vantage Sales Systems · Tested: see Flow_Tests/ · Assigns new cases to the L1 queue for Product Area x Account region (no region = AMER), moves newly escalated cases to L2_Escalations with Escalated_At__c, and sets SLA due dates via VantageCaseSlaService.setDueDates.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxRegionGroup</name>
        <dataType>String</dataType>
        <expression>IF(OR(TEXT({!$Record.Account.Region__c}) = 'EMEA', TEXT({!$Record.Account.Region__c}) = 'APAC'), 'INTL', 'AMER')</expression>
    </formulas>
    <formulas>
        <name>fxL1QueueName</name>
        <dataType>String</dataType>
        <expression>CASE(TEXT({!$Record.Product_Area__c}), 'Data Cloud', 'L1_Platform_' &amp; {!fxRegionGroup}, 'Guard', 'L1_Platform_' &amp; {!fxRegionGroup}, 'Connect', 'L1_Apps_' &amp; {!fxRegionGroup}, 'Insight', 'L1_Apps_' &amp; {!fxRegionGroup}, 'L1_Services')</expression>
    </formulas>
    <formulas>
        <name>fxIsNewEscalation</name>
        <dataType>Boolean</dataType>
        <expression>AND(TEXT({!$Record.Status}) = 'Escalated', OR(ISBLANK({!$Record__Prior.Id}), TEXT({!$Record__Prior.Status}) &lt;&gt; 'Escalated'))</expression>
    </formulas>
    <formulas>
        <name>fxEscalatedAt</name>
        <dataType>DateTime</dataType>
        <expression>IF(AND(ISBLANK({!$Record__Prior.Id}), NOT(ISBLANK({!$Record.Escalated_At__c}))), {!$Record.Escalated_At__c}, NOW())</expression>
    </formulas>
    <interviewLabel>Case Routing {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case Routing</label>
