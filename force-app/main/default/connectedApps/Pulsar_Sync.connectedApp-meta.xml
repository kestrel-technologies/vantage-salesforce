<?xml version="1.0" encoding="UTF-8"?>
<ConnectedApp xmlns="http://soap.sforce.com/2006/04/metadata">
    <contactEmail>sales-ops@vantage.kestrel.example</contactEmail>
    <description>Pulsar marketing automation lead sync (2022, C. Marsh)</description>
    <label>Pulsar Sync</label>
    <oauthConfig>
        <callbackUrl>https://app.pulsar-marketing.example/integrations/salesforce/callback</callbackUrl>
        <isAdminApproved>true</isAdminApproved>
        <isConsumerSecretOptional>false</isConsumerSecretOptional>
        <isIntrospectAllTokens>false</isIntrospectAllTokens>
        <isSecretRequiredForRefreshToken>true</isSecretRequiredForRefreshToken>
        <scopes>Api</scopes>
        <scopes>RefreshToken</scopes>
    </oauthConfig>
    <oauthPolicy>
        <ipRelaxation>BYPASS</ipRelaxation>
        <refreshTokenPolicy>specific_lifetime:90:DAYS</refreshTokenPolicy>
    </oauthPolicy>
    <profileName>Skyward Legacy Admin</profileName>
</ConnectedApp>
