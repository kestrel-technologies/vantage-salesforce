<?xml version="1.0" encoding="UTF-8"?>
<FlowTest xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>A new Connect case gets an L1 queue owner and SLA due dates.</description>
    <flowApiName>Case_Routing</flowApiName>
    <label>Case Routing Test</label>
    <testPoints>
        <elementApiName>Start</elementApiName>
        <parameters>
            <leftValueReference>$Record</leftValueReference>
            <type>InputTriggeringRecordInitial</type>
            <value>
                <sobjectValue>{"Subject": "Flow test case", "Origin": "Phone", "Priority": "P2", "Product_Area__c": "Connect", "Status": "New"}</sobjectValue>
            </value>
        </parameters>
    </testPoints>
    <testPoints>
        <assertions>
            <conditions>
                <leftValueReference>varOwnerId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <errorMessage>new case should be assigned to an L1 queue</errorMessage>
        </assertions>
        <assertions>
            <conditions>
                <leftValueReference>varResponseDue</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <errorMessage>response SLA should be set</errorMessage>
        </assertions>
        <assertions>
            <conditions>
                <leftValueReference>varResolutionDue</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <errorMessage>resolution SLA should be set</errorMessage>
        </assertions>
        <elementApiName>Finish</elementApiName>
    </testPoints>
</FlowTest>
